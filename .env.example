# Copiar a .env (no se sube a git). En la EC2 lo genera CloudFormation.
# Local: catálogo y pedidos corren en otros compose y se alcanzan por el host de Docker Desktop.
CATALOG_BASE_URL=http://host.docker.internal:8081
ORDERS_BASE_URL=http://host.docker.internal:8082
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://pedidos360-fel.vercel.app
ENFORCE_ROLES=true
