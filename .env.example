# Copiar a .env (no se sube a git). En la EC2 lo genera CloudFormation.
# Local: catálogo, pedidos, reportería y auditoría corren en otros compose y se alcanzan por el host de Docker Desktop.
CATALOG_BASE_URL=http://host.docker.internal:8081
ORDERS_BASE_URL=http://host.docker.internal:8082
REPORT_BASE_URL=http://host.docker.internal:8084
AUDIT_BASE_URL=http://host.docker.internal:8085
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://pedidos360-fel.vercel.app
ENFORCE_ROLES=true
# Client secret del app registration de la API (Graph: User.Read.All y Application.Read.All)
GRAPH_CLIENT_SECRET=
